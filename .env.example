# Copy to .env.local and fill in. Every variable is optional for `pnpm dev`:
# a missing key shows a "not configured" state instead of crashing.

# Supabase: Project settings -> API keys
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: the secret key (sb_secret_...) or the legacy service_role key.
# Used by the cron routes. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# TODO(owner): pin model IDs from AI Studio once tested.
GEMINI_MODEL_TEXT=gemini-flash-latest
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
# TODO(owner): the voice that sounded best to the cook in the Phase 0 test.
GEMINI_TTS_VOICE=Kore

# Telegram: create a bot with @BotFather, then message it and read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any long random string. Vercel sends it as "Authorization: Bearer <secret>" to cron routes.
CRON_SECRET=

# Public URL of the app, used in Telegram links.
APP_URL=http://localhost:3000
